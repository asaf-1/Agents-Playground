{
  "openapi": "3.1.0",
  "info": {
    "title": "Agents Playground API",
    "version": "1.0.0",
    "description": "Local-first demo API for the AI-native QA playground. Served by server.js; documented here for Swagger UI and schema contract tests."
  },
  "servers": [{ "url": "/", "description": "Same-origin (server.js)" }],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/api/orders": {
      "get": {
        "operationId": "getOrders",
        "summary": "List orders",
        "parameters": [
          {
            "name": "mode",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["stable", "slow", "flaky"]
            }
          },
          { "name": "runKey", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Orders payload",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OrdersResponse" }
              }
            }
          }
        }
      }
    },
    "/api/products": {
      "get": {
        "operationId": "getProducts",
        "summary": "List the product catalog",
        "parameters": [
          { "name": "runKey", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Product catalog",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductsResponse" }
              }
            }
          }
        }
      }
    },
    "/api/products/{id}": {
      "get": {
        "operationId": "getProduct",
        "summary": "Get one product by SKU",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Product detail",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductResponse" }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "operationId": "getUsers",
        "summary": "List users",
        "parameters": [
          { "name": "runKey", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "User list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UsersResponse" }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createUser",
        "summary": "Create a user (RBAC-gated)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateUserRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CreateUserResponse" }
              }
            }
          },
          "403": {
            "description": "RBAC forbidden",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/session": {
      "get": {
        "operationId": "getSession",
        "summary": "Current session state",
        "parameters": [
          { "name": "runKey", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Session state",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SessionResponse" }
              }
            }
          }
        }
      }
    },
    "/api/test/flags": {
      "get": {
        "operationId": "getFlags",
        "summary": "Read resolved drift flags for a runKey",
        "parameters": [
          { "name": "runKey", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Resolved flags",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FlagsResponse" }
              }
            }
          }
        }
      }
    },
    "/api/bank/status": {
      "get": {
        "tags": ["Playground Bank"],
        "operationId": "getBankStatus",
        "summary": "Which database the bank runs on",
        "responses": {
          "200": {
            "description": "Database and migration count",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankStatusResponse" }
              }
            }
          }
        }
      }
    },
    "/api/bank/register": {
      "post": {
        "tags": ["Playground Bank"],
        "operationId": "registerBankAccount",
        "summary": "Create a customer account and sign in",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BankRegisterRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created; sets the pb_session cookie",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankAccountResponse" }
              }
            }
          },
          "400": {
            "description": "Some fields need attention (VALIDATION_FAILED)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankError" }
              }
            }
          },
          "409": {
            "description": "An account with this email already exists (EMAIL_TAKEN)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankError" }
              }
            }
          },
          "415": {
            "description": "The request wasn't sent as application/json",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankError" }
              }
            }
          }
        }
      }
    },
    "/api/bank/login": {
      "post": {
        "tags": ["Playground Bank"],
        "operationId": "bankLogin",
        "summary": "Sign in",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BankLoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in; sets the pb_session cookie",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankAccountResponse" }
              }
            }
          },
          "400": {
            "description": "Some fields need attention (VALIDATION_FAILED)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankError" }
              }
            }
          },
          "401": {
            "description": "Wrong email or password (INVALID_CREDENTIALS)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankError" }
              }
            }
          },
          "403": {
            "description": "The account is locked (ACCOUNT_LOCKED)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankError" }
              }
            }
          },
          "415": {
            "description": "The request wasn't sent as application/json",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankError" }
              }
            }
          }
        }
      }
    },
    "/api/bank/logout": {
      "post": {
        "tags": ["Playground Bank"],
        "operationId": "bankLogout",
        "summary": "Sign out",
        "responses": {
          "200": {
            "description": "Signed out; clears the cookie",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["message"],
                  "properties": { "message": { "type": "string" } }
                }
              }
            }
          },
          "415": {
            "description": "The request wasn't sent as application/json",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankError" }
              }
            }
          }
        }
      }
    },
    "/api/bank/me": {
      "get": {
        "tags": ["Playground Bank"],
        "operationId": "getBankAccount",
        "summary": "The signed-in account, with profile and settings",
        "security": [{ "bankSession": [] }],
        "responses": {
          "200": {
            "description": "The account",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankAccountResponse" }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankError" }
              }
            }
          }
        }
      }
    },
    "/api/bank/me/profile": {
      "patch": {
        "tags": ["Playground Bank"],
        "operationId": "updateBankProfile",
        "summary": "Change your name or contact details",
        "security": [{ "bankSession": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BankProfileUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated account",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankAccountResponse" }
              }
            }
          },
          "400": {
            "description": "Some fields need attention (VALIDATION_FAILED)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankError" }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankError" }
              }
            }
          },
          "403": {
            "description": "Demo accounts are read-only (DEMO_READ_ONLY)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankError" }
              }
            }
          },
          "415": {
            "description": "The request wasn't sent as application/json",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankError" }
              }
            }
          }
        }
      }
    },
    "/api/bank/me/settings": {
      "put": {
        "tags": ["Playground Bank"],
        "operationId": "updateBankSettings",
        "summary": "Replace your settings",
        "security": [{ "bankSession": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BankSettings" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated account",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankAccountResponse" }
              }
            }
          },
          "400": {
            "description": "Some fields need attention (VALIDATION_FAILED)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankError" }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankError" }
              }
            }
          },
          "403": {
            "description": "Demo accounts are read-only (DEMO_READ_ONLY)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankError" }
              }
            }
          },
          "415": {
            "description": "The request wasn't sent as application/json",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankError" }
              }
            }
          }
        }
      }
    },
    "/api/bank/admin/users": {
      "get": {
        "tags": ["Playground Bank"],
        "operationId": "listBankUsers",
        "summary": "Every account (Support and Admin)",
        "security": [{ "bankSession": [] }],
        "responses": {
          "200": {
            "description": "All accounts",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankUsersResponse" }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankError" }
              }
            }
          },
          "403": {
            "description": "Customers can't see this (FORBIDDEN)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankError" }
              }
            }
          }
        }
      }
    },
    "/api/bank/admin/users/{id}": {
      "patch": {
        "tags": ["Playground Bank"],
        "operationId": "updateBankUser",
        "summary": "Change a user's role or lock them (Admin)",
        "security": [{ "bankSession": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BankAdminUserUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated user",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankUserResponse" }
              }
            }
          },
          "400": {
            "description": "Some fields need attention (VALIDATION_FAILED)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankError" }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankError" }
              }
            }
          },
          "403": {
            "description": "Not an Admin (FORBIDDEN), or a demo account (DEMO_READ_ONLY)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankError" }
              }
            }
          },
          "404": {
            "description": "No such user (USER_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankError" }
              }
            }
          },
          "409": {
            "description": "Admins can't change their own account (CANNOT_CHANGE_SELF)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankError" }
              }
            }
          },
          "415": {
            "description": "The request wasn't sent as application/json",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BankError" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bankSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "pb_session",
        "description": "Playground Bank session. Set (httpOnly) by /api/bank/login and /api/bank/register."
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string" },
          "port": { "type": "integer" },
          "service": { "type": "string" }
        }
      },
      "Order": {
        "type": "object",
        "required": ["id", "customer", "status", "total", "region"],
        "properties": {
          "id": { "type": "string" },
          "customer": { "type": "string" },
          "status": { "type": "string" },
          "total": { "type": "string" },
          "region": { "type": "string" }
        }
      },
      "OrdersResponse": {
        "type": "object",
        "required": ["orders", "mode", "runKey"],
        "properties": {
          "attempt": { "type": "integer" },
          "delayMs": { "type": "integer" },
          "mode": { "type": "string" },
          "orders": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Order" }
          },
          "refreshedAt": { "type": "string" },
          "runKey": { "type": "string" }
        }
      },
      "Product": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "price",
          "currency",
          "stock",
          "status"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "price": { "type": "number" },
          "currency": { "type": "string" },
          "stock": { "type": "integer" },
          "status": { "type": "string" }
        }
      },
      "ProductsResponse": {
        "type": "object",
        "required": ["products", "total"],
        "properties": {
          "products": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Product" }
          },
          "total": { "type": "integer" }
        }
      },
      "ProductResponse": {
        "type": "object",
        "required": ["product"],
        "properties": {
          "product": { "$ref": "#/components/schemas/Product" }
        }
      },
      "User": {
        "type": "object",
        "required": ["id", "name", "role", "status"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "status": { "type": "string" },
          "createdAt": { "type": "string" }
        }
      },
      "UsersResponse": {
        "type": "object",
        "required": ["users", "total"],
        "properties": {
          "users": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/User" }
          },
          "total": { "type": "integer" }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string", "enum": ["Viewer", "Editor", "Admin"] }
        }
      },
      "CreateUserResponse": {
        "type": "object",
        "required": ["message", "user"],
        "properties": {
          "message": { "type": "string" },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "SessionResponse": {
        "type": "object",
        "required": ["authenticated", "authRequired"],
        "properties": {
          "authenticated": { "type": "boolean" },
          "authRequired": { "type": "boolean" },
          "role": { "type": "string" },
          "user": { "type": "object" }
        }
      },
      "FlagsResponse": {
        "type": "object",
        "required": ["runKey", "flags"],
        "properties": {
          "runKey": { "type": "string" },
          "flags": { "type": "object" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string" },
          "code": { "type": "string" }
        }
      },
      "BankUser": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "email",
          "fullName",
          "role",
          "status",
          "isDemo",
          "createdAt"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string" },
          "fullName": { "type": "string" },
          "role": {
            "type": "string",
            "enum": ["customer", "support", "admin"]
          },
          "status": { "type": "string", "enum": ["active", "locked"] },
          "isDemo": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "BankProfile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phone",
          "addressLine",
          "city",
          "postalCode",
          "country",
          "updatedAt"
        ],
        "properties": {
          "phone": { "type": "string" },
          "addressLine": { "type": "string" },
          "city": { "type": "string" },
          "postalCode": { "type": "string" },
          "country": { "type": "string" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "BankSettings": {
        "type": "object",
        "additionalProperties": false,
        "required": ["currency", "locale", "emailAlerts", "statementEmails"],
        "properties": {
          "currency": {
            "type": "string",
            "enum": ["USD", "EUR", "GBP", "ILS"]
          },
          "locale": { "type": "string", "enum": ["en-US", "en-GB", "de-DE"] },
          "emailAlerts": { "type": "boolean" },
          "statementEmails": { "type": "boolean" }
        }
      },
      "BankAccountResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user", "profile", "settings"],
        "properties": {
          "user": { "$ref": "#/components/schemas/BankUser" },
          "profile": { "$ref": "#/components/schemas/BankProfile" },
          "settings": { "$ref": "#/components/schemas/BankSettings" }
        }
      },
      "BankUserResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user"],
        "properties": { "user": { "$ref": "#/components/schemas/BankUser" } }
      },
      "BankUsersResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["users", "total"],
        "properties": {
          "users": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/BankUser" }
          },
          "total": { "type": "integer" }
        }
      },
      "BankStatusResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["database", "migrations"],
        "properties": {
          "database": { "type": "string", "enum": ["postgres", "pglite"] },
          "migrations": { "type": "integer", "minimum": 1 }
        }
      },
      "BankError": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "errors": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "description": "Per-field messages, on 400 VALIDATION_FAILED."
          }
        }
      },
      "BankRegisterRequest": {
        "type": "object",
        "required": ["fullName", "email", "password", "acceptTerms"],
        "properties": {
          "fullName": { "type": "string", "minLength": 2, "maxLength": 80 },
          "email": { "type": "string", "format": "email" },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "description": "At least one letter and one number."
          },
          "acceptTerms": { "type": "boolean", "const": true }
        }
      },
      "BankLoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string" },
          "password": { "type": "string" }
        }
      },
      "BankProfileUpdate": {
        "type": "object",
        "description": "Send only the fields to change.",
        "properties": {
          "fullName": { "type": "string", "minLength": 2, "maxLength": 80 },
