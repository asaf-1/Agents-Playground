# Standalone test runner configuration.
#
# Copy to .env and fill in, or set these however your host does env vars.
# Nothing here is read by the repository's demo app - this file belongs to the
# test runner alone.

# --- Where runs go -----------------------------------------------------------

# Fine-grained personal access token. Scope it to ONE repository and to
# Actions: read and write. Nothing else. This is the only real secret here:
# it is what lets a signed-in user start a pipeline run without having any
# GitHub access of their own.
TR_GITHUB_TOKEN=

# The repository holding the tests and the workflow.
TR_REPO=asaf-1/Agents-Playground

# Branch or SHA the runs execute against.
TR_REF=main

# The workflow file that actually runs the tests.
TR_WORKFLOW=remote-test-runner.yml

# --- Who can get in ----------------------------------------------------------

# invite  - there is a sign-up form, but it needs the code below (recommended)
# open    - anyone who can reach the page can create an account
# off     - no sign-up form; you create accounts yourself
TR_SIGNUP_MODE=invite

# Required when TR_SIGNUP_MODE=invite. Give this to the people you want in.
# Change it to revoke sign-up for anyone who has not registered yet.
#
# Use at least 24 random characters - the runner reports a configuration error
# below that length. Wrong codes are cheap to try, and the first account created
# on a fresh deployment becomes admin, so a guessable code is an admin account.
# Generate one:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
TR_INVITE_CODE=

# Where accounts are stored. Put this on a mounted volume, or accounts vanish
# on redeploy. The first account created becomes admin.
TR_USERS_FILE=./data/users.json

# Accounts declared here instead of on disk. For a host with NO persistent disk
# (Render's free tier, for instance), where the file store is wiped on every
# restart and the next person to sign up would become admin again.
#
# One entry per line (commas work too, "#" lines are comments):
#
#   TR_USERS=alice:admin:scrypt$16384$8$1$<salt>$<derived>
#   bob:scrypt$16384$8$1$<salt>$<derived>
#
# "username:hash" or "username:role:hash", role being admin or user (default
# user). Give at least one entry the admin role, or nobody can manage accounts.
# Generate an entry, one per person:
#   npm run password -- --username alice --role admin --generate
#
# These accounts cannot be edited, re-roled or deleted from inside the app - the
# environment is their only definition, so change it here and restart. With them
# set, an unwritable user store costs you self-signup only.
TR_USERS=

# How long a login lasts, in hours.
TR_SESSION_HOURS=12

# Set to true when serving over HTTPS so the session cookie gets Secure.
TR_SECURE_COOKIE=false

# Set to true ONLY when a reverse proxy you control sits directly in front of
# this app and overwrites X-Forwarded-For. It makes the runner read the client
# address for rate limiting from that header (the last hop) instead of from the
# socket.
#
# Leave it false otherwise. With no such proxy, any caller can send their own
# X-Forwarded-For and get a fresh rate-limit budget on every request, which
# quietly disables the per-IP limits on login and sign-up.
TR_TRUST_PROXY=false

# --- Serving -----------------------------------------------------------------

TR_PORT=4300

# 0.0.0.0 in a container, 127.0.0.1 when running it on your own machine.
TR_HOST=127.0.0.1

# --- Flow list (usually leave alone) -----------------------------------------

# Path inside the repo to the catalog the pipeline keeps up to date. The runner
# fetches this through the GitHub API, which is why it needs no checkout.
TR_CATALOG_PATH=scripts/test-runner/flow-catalog.json

# Point at a local catalog file instead, for development.
TR_LOCAL_CATALOG=

# Or an explicit raw URL, if you serve the catalog yourself.
TR_CATALOG_URL=
