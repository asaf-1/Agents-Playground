{
  "name": "agents-playground-test-runner",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone test runner: colleagues sign in here and start pipeline test runs without any GitHub, repository, or pipeline access.",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "check": "node --check server.js && node -e \"require('./src/config.js');require('./src/store.js');require('./src/auth.js');require('./src/github.js');console.log('modules load')\"",
    "passwd": "node bin/passwd.js"
  },
  "engines": {
    "node": ">=20"
  }
}
