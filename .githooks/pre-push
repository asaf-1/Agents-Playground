#!/usr/bin/env sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

direct_main_push=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    direct_main_push=1
  fi
done

if [ "$direct_main_push" -eq 1 ] && [ "${ALLOW_DIRECT_MAIN_PUSH:-0}" != "1" ]; then
  echo "[pre-push] Direct pushes to main are blocked."
  echo "[pre-push] Push a feature branch, open a PR, complete Codex/Claude review, and merge after the PR gates pass."
  echo "[pre-push] Emergency override only: set ALLOW_DIRECT_MAIN_PUSH=1 for this push."
  exit 1
fi

if command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/pre-push-check.ps1
else
  node scripts/pre-push-check.js
fi
