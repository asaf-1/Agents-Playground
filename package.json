{
  "name": "agents-playground",
  "version": "1.0.0",
  "private": true,
  "description": "Agents-Playground: a local-first playground for AI QA agents (Playwright planner/generator/healer + custom diagnostician/reporter) with E2E coverage.",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "vite build",
    "dev:web": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:sanity": "playwright test tests/e2e/sanity/sanity-smoke.spec.ts",
    "test:regression": "playwright test",
    "test:functional:positive": "playwright test tests/e2e/functional/positive/functional-positive.spec.ts",
    "test:functional:negative": "playwright test tests/e2e/functional/negative/functional-negative.spec.ts",
    "test:nonfunctional": "playwright test tests/e2e/non-functional/non-functional-quality.spec.ts",
    "test:contract": "playwright test tests/e2e/contracts/api-contract-governance.spec.ts",
    "test:db": "playwright test tests/e2e/app/api-bank",
    "db:schema": "node scripts/db/schema.js",
    "db:schema:check": "node scripts/db/schema.js --check",
    "db:audit": "node scripts/db/index-audit.js",
    "graphql:schema": "node scripts/graphql/schema.js",
    "graphql:schema:check": "node scripts/graphql/schema.js --check",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:runner": "playwright test -c playwright.runner.config.ts",
    "test:tracing": "playwright test -c playwright.tracing.config.ts",
    "test:traced": "node scripts/tracing/test-traced.js",
    "trace:up": "docker compose --profile tracing up -d jaeger",
    "trace:start": "npm run build && node scripts/tracing/start-traced.js",
    "trace:down": "docker compose --profile tracing rm --stop --force jaeger",
    "media:record": "node scripts/media/record.js",
    "test:ui-heal": "playwright test tests/e2e/scenarios/ui-change-healing.spec.ts",
    "test:flaky": "playwright test tests/e2e/scenarios/flaky-network-recovery.spec.ts",
    "test:api": "playwright test tests/e2e/scenarios/api-error-diagnosis.spec.ts",
    "test:dynamic": "playwright test tests/e2e/scenarios/dynamic-content-validation.spec.ts",
    "test:generic-healing": "playwright test tests/e2e/scenarios/generic-self-healing.spec.ts",
    "test:page-contracts": "playwright test tests/e2e/scenarios/page-contract-validation.spec.ts",
    "test:classification": "playwright test tests/e2e/scenarios/failure-classification-and-patch-proposal.spec.ts",
    "test:real-agent": "playwright test tests/e2e/scenarios/real-agent-proof.spec.ts",
    "test:generated": "playwright test tests/e2e/generated",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "flows:discover": "node scripts/test-runner/discover-flows.js",
    "flows:list": "node scripts/test-runner/discover-flows.js --list",
    "flows:check": "node scripts/test-runner/discover-flows.js --check",
    "knowledge:build": "node scripts/test-runner/build-knowledge.js",
    "knowledge:check": "node scripts/test-runner/build-knowledge.js --check",
    "test:flow": "node scripts/test-runner/exec-flow.js",
    "test:remote": "node scripts/test-runner/trigger-remote.js",
    "docker:pull-runner": "docker compose pull qa-runner",
    "docker:prepare-runner": "docker compose pull qa-runner || docker compose build qa-runner",
    "test:docker:smoke": "npm run docker:prepare-runner && docker compose run --rm -e CI=true qa-runner npm run test:sanity",
    "test:docker:e2e": "npm run docker:prepare-runner && docker compose run --rm -e CI=true qa-runner npm run test:e2e",
    "docker:shell": "docker compose run --rm qa-runner bash",
    "k8s:up": "kind create cluster --config kind/kind-config.yaml",
    "k8s:deploy": "docker build --provenance=false --sbom=false -t agents-playground:local . && kind load docker-image agents-playground:local --name agents-playground && kubectl apply -f k8s/ && kubectl rollout restart deployment/agents-playground -n agents-playground && kubectl rollout status deployment/agents-playground -n agents-playground --timeout=180s",
    "k8s:test": "node scripts/k8s-test.js",
    "k8s:test:full": "node scripts/k8s-test.js --full",
    "k8s:status": "kubectl get pods,svc,deployment -l app=agents-playground -n agents-playground",
    "k8s:logs": "kubectl describe deployment/agents-playground -n agents-playground && kubectl logs -l app=agents-playground -n agents-playground --tail=200",
    "k8s:down": "kind delete cluster --name agents-playground",
    "k8s:tf:up": "node scripts/k8s-tf.js up",
    "k8s:tf:down": "node scripts/k8s-tf.js down",
    "k8s:tf:full": "node scripts/k8s-tf.js full",
    "k8s:tf:check": "node scripts/k8s-tf.js check",
    "github:tf:check": "node scripts/github-tf.js check",
    "github:tf:plan": "node scripts/github-tf.js plan",
    "infra:check": "node scripts/infra-versions.js check",
    "infra:report": "node scripts/infra-versions.js report",
    "infra:update": "node scripts/infra-versions.js update",
    "github:tf:apply": "node scripts/github-tf.js apply",
    "obsidian:closeout": "node scripts/obsidian-closeout.js",
    "review:ai:mark": "node scripts/github/mark-ai-review.js",
    "review:claude:pull": "node scripts/github/fetch-claude-review.js",
    "changelog": "node scripts/changelog.js",
    "changelog:check": "node scripts/changelog.js --check"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@hookform/resolvers": "^5.4.0",
    "@playwright/test": "^1.65.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@tanstack/react-query": "^5.105.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.65.0",
    "msw": "^2.15.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "swagger-ui-dist": "^5.34.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wait-on": "^9.5.1",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.0",
    "@opentelemetry/core": "^3.1.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.0",
    "@opentelemetry/resources": "^3.1.0",
    "@opentelemetry/sdk-trace": "^3.1.0",
    "graphql": "^16.14.2",
    "pg": "^8.23.1"
  }
}
